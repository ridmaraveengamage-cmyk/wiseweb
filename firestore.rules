// Copy of the rules published in the Firebase console (project wiseweb-7c15a,
// Firestore > Rules). Each signed-in learner can read and write only users/{their uid}.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
